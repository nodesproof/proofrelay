# One verifier, run by someone who is not the deployment's operator.
#
#   cp .env.verifier-standalone.example .env
#   docker compose -f infra/docker-compose.verifier.yml up --build
#
# This is the whole configuration. There is no database URL, no API port, no
# admin or keeper key, and no deploy block: a verifier reads the contract, 0G
# Storage and 0G Compute directly and never talks to the operator's services.
# If you find yourself needing a value that is not here, that is a bug in the
# verifier, not in your setup — please report it.

# ─── Chain ────────────────────────────────────────────────────────────────────
# Everything network-shaped — RPC, storage indexer, compute router and model —
# is defaulted from CHAIN_ID. Override a URL only to point at your own node.
CHAIN_ID=16661
OG_RPC_URL=https://evmrpc.0g.ai
PROOFRELAY_ADDRESS=0xD3101C19175b50fD47C9e0B14A2dc63485f527D1

# ─── Your verifier ────────────────────────────────────────────────────────────
# The key that registers, commits, reveals and collects. It is your onchain
# identity in this market; fund it with 0G (see docs/VERIFIER_OPERATOR.md for
# how much) and keep it to yourself. The profile picks a pipeline preset:
#   a = evidence depth 2, support threshold 0.55
#   b = evidence depth 3, support threshold 0.50
VERIFIER_PROFILE=a
VERIFIER_A_PRIVATE_KEY=
VERIFIER_POLL_MS=3000
# Rewards are pull-based and collecting costs gas. Hold until the unclaimed
# total covers it (default 0.002 0G); 0 collects after every task.
VERIFIER_MIN_COLLECT_WEI=2000000000000000

# ─── 0G Storage ───────────────────────────────────────────────────────────────
# Your revealed reports are written here on your own key. Leave
# STORAGE_PRIVATE_KEY blank to pay from the verifier key above; set it only to
# separate the fee-paying key from the signing one.
STORAGE_DRIVER=zerog
STORAGE_INDEXER_RPC=
STORAGE_PRIVATE_KEY=
STORAGE_ROOT=.proofrelay/storage

# ─── 0G Compute ───────────────────────────────────────────────────────────────
# zerog-router: a key from https://pc.0g.ai. The model defaults to one every
#   mainnet provider can seed (deepseek-v4-flash); this pipeline sends a seed
#   on every completion and refuses a provider that would drop it.
# zerog-broker: no account. COMPUTE_PRIVATE_KEY funds an onchain ledger and
#   signs each request; COMPUTE_MODEL is then required and must be an id from
#   the onchain registry, which is a different catalog from the router's.
# local: the deterministic offline engine — for trying the loop, not for
#   earning. Reports say which engine produced them.
COMPUTE_DRIVER=zerog-router
COMPUTE_API_KEY=
COMPUTE_MODEL=
COMPUTE_PRIVATE_KEY=
COMPUTE_TIMEOUT_MS=90000
COMPUTE_VERIFY_TEE=true
COMPUTE_TRUST_MODE=verified
COMPUTE_REQUIRE_PARAMETERS=true
COMPUTE_SEED=1337
