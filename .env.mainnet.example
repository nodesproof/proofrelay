# ProofRelay on 0G mainnet (chain 16661).
#
# HOW TO USE THIS FILE
#   cp .env.mainnet.example .env      # over a .env with NO funded keys in it
#   npm run wallets                   # generate a key per role (never overwrites)
#   rm -f .env.local                  # <- see below; this is not optional
#   # send real 0G to the operator address wallets printed, then:
#   npm run fund && npm run deploy && npm run approve-verifiers && npm run doctor
#
# .env.local WINS OVER THIS FILE. It is written by `npm run seed` / `npm run
# demo` and pins CHAIN_ID, PROOFRELAY_ADDRESS and the deploy block to whatever
# network was last seeded. Left in place it silently keeps every service on
# Galileo while this file says mainnet. `grep CHAIN_ID .env.local` before
# blaming anything else.
#
# WHAT IS DIFFERENT FROM TESTNET, and none of it is cosmetic:
#   - There is no faucet. Every 0G spent here is bought, and a mistake is not
#     re-droppable. `npm run deploy` asks for a typed confirmation on mainnet.
#   - The compute router is a different host with a different catalog, and a
#     key issued on testnet is rejected here. Get one at https://pc.0g.ai, or
#     use COMPUTE_DRIVER=zerog-broker and skip the account entirely.
#   - Blocks land about twice as fast (~1 s against Galileo's ~2 s). Anything
#     that turns a duration into a block count reads this from CHAIN_ID.
#   - Roles sharing one key is tolerable on a testnet demo and is not here.
#     Point ADMIN_ADDRESS at a multisig and keep the keeper, adjudicator and
#     storage keys separate from it and from each other. `npm run roles` is the
#     check; it reads the chain, not this file. Do it BEFORE the deploy: the
#     three role addresses are constructor arguments, so a deployment that
#     starts separated never needs the grant-and-revoke dance at all.

# ─── Chain ────────────────────────────────────────────────────────────────────
CHAIN_ID=16661
OG_RPC_URL=https://evmrpc.0g.ai
PROOFRELAY_ADDRESS=0x0000000000000000000000000000000000000000
# Printed by `npm run deploy`. The indexer starts here instead of at genesis —
# mainnet is past 43 million blocks, and the API refuses to start with this at 0.
PROOFRELAY_DEPLOY_BLOCK=0
# Seconds per block, used to size the adjudicator's dispute lookback. Defaulted
# from CHAIN_ID (mainnet 1, Galileo 2); set it only to override a measurement.
# CHAIN_BLOCK_SECONDS=

# ─── Funding floors ───────────────────────────────────────────────────────────
# You fund ONE address — the operator below — and `npm run fund` tops the rest up
# TO these figures. Re-running is idempotent: an address already above its floor
# is skipped, so this is also how you refill later.
#
# Sized for an end-to-end mainnet run of roughly 10 tasks, from measured
# receipts at the 4 gwei both networks settle at. Raise them for a deployment
# that expects real traffic; the per-unit costs are in the README table.
FUND_KEEPER=0.03
FUND_ADJUDICATOR=0.02
FUND_VERIFIER_A=0.05
FUND_VERIFIER_B=0.05
FUND_VERIFIER_C=0.05
FUND_VERIFIER_D=0.05
FUND_CREATOR=0.02
FUND_STORAGE=0.10
# Left with the operator for the deploy (0.0188) and the role transactions.
FUND_RESERVE=0.05

KEEPER_PRIVATE_KEY=
ADJUDICATOR_PRIVATE_KEY=
# Deployer/admin. On mainnet this should be a multisig, not a generated key.
PRIVATE_KEY=
ADMIN_ADDRESS=
KEEPER_ADDRESS=
ADJUDICATOR_ADDRESS=
VERIFIER_A_ADDRESS=
VERIFIER_B_ADDRESS=
VERIFIER_C_ADDRESS=
VERIFIER_D_ADDRESS=
STORAGE_ADDRESS=
# Optional second pauser, so an incident can be stopped without the admin key.
# The constructor already grants PAUSER_ROLE to the admin; `npm run roles:apply`
# grants it to this address too when it is set.
PAUSER_ADDRESS=

# ─── 0G Storage ───────────────────────────────────────────────────────────────
# The mainnet indexer, and a key that pays real storage fees. Price per sector
# is the same as testnet (3.07e-8 0G per 256 B), so the gas on the flow
# transaction dominates, not the storage itself.
STORAGE_DRIVER=zerog
STORAGE_ROOT=.proofrelay/storage
STORAGE_INDEXER_RPC=https://indexer-storage-turbo.0g.ai
STORAGE_PRIVATE_KEY=
STORAGE_GATEWAYS=

# ─── 0G Compute ───────────────────────────────────────────────────────────────
# Two ways to reach mainnet inference; pick one.
#
#   zerog-router — https://router-api.0g.ai/v1, key from https://pc.0g.ai.
#     Defaulted from CHAIN_ID, so COMPUTE_DRIVER + COMPUTE_API_KEY is enough.
#
#   zerog-broker — no account and no API key. COMPUTE_PRIVATE_KEY funds an
#     on-chain ledger and signs each request; the SDK picks the mainnet ledger
#     and inference contracts off the chain id on its own. Budget ~0.1 0G for
#     roughly 10,000 requests, plus gas for one acknowledgeProviderSigner per
#     provider.
#
#     COMPUTE_MODEL is NOT optional on this path. The on-chain registry is a
#     different, smaller catalog than the router's — 12 services against 32,
#     under different ids (zai-org/GLM-5-FP8, glm-5.3, 0GM-1.0-35B-A3B, …) —
#     and it does not carry deepseek-v4-flash at all. Left unset, COMPUTE_MODEL
#     falls back to the router default and the broker refuses, naming every
#     model the registry does offer. Read the registry yourself with
#     `broker.inference.listService()`; the match is exact, last path segment,
#     or substring, so COMPUTE_MODEL=glm-5.3 resolves zai-org/glm-5.3.
#
# COMPUTE_MODEL defaults to deepseek-v4-flash on mainnet, and that default is
# load-bearing: this pipeline sends a seed on every completion and sets
# X-0G-Provider-Require-Parameters, so a model whose providers do not accept a
# seed is refused rather than served non-reproducibly. As of this writing the
# larger glm-5.x models are exactly that case — every mainnet provider for
# glm-5.1 and glm-5.2 advertises `temperature` but not `seed`. Check before
# changing it, no key required:
#   curl -s https://router-api.0g.ai/v1/providers | jq '[.data[]
#     | select(.supported_parameters | index("seed"))
#     | {model: .canonical_id, provider: .provider_identity, tee: .tee_attested}]'
COMPUTE_DRIVER=zerog-router
COMPUTE_BASE_URL=
COMPUTE_API_KEY=
COMPUTE_MODEL=
COMPUTE_PRIVATE_KEY=
COMPUTE_TIMEOUT_MS=90000
COMPUTE_VERIFY_TEE=true
COMPUTE_TRUST_MODE=verified
COMPUTE_REQUIRE_PARAMETERS=true
COMPUTE_SEED=1337

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
TRUST_PROXY_HOPS=0
SPEND_RATE_LIMIT_MAX=10
DATABASE_URL=postgres://proofrelay:proofrelay@localhost:5432/proofrelay
POSTGRES_PASSWORD=proofrelay
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
SESSION_TTL_SEC=3600
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
PRODUCER_ID=proofrelay-api/1.0.0

FETCH_MAX_BYTES=524288
FETCH_TIMEOUT_MS=15000
FETCH_ALLOW_PRIVATE=0

# ─── Indexer and keeper ───────────────────────────────────────────────────────
# Blocks land about every second here, so the poll is tightened to match; the
# confirmation depth stays at 2, which is ~2 s of finality rather than ~4 s.
INDEXER_ENABLED=true
INDEXER_POLL_MS=1000
INDEXER_CONFIRMATIONS=2
# INDEXER_START_BLOCK=
INDEXER_BATCH_SIZE=2000
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_POLL_MS=1500

# ─── Verifier workers ─────────────────────────────────────────────────────────
# Each verifier still gets its own .env.verifier-<x> for its own
# compute credential. A testnet COMPUTE_API_KEY in those files is rejected by the
# mainnet router — reissue it, or move that verifier to zerog-broker.
VERIFIER_A_PRIVATE_KEY=
VERIFIER_B_PRIVATE_KEY=
VERIFIER_C_PRIVATE_KEY=
VERIFIER_D_PRIVATE_KEY=
VERIFIER_POLL_MS=3000

# ─── Web ──────────────────────────────────────────────────────────────────────
# VITE_CHAIN_ID is what points the browser's wallet layer, explorer links and
# tip floor at mainnet. VITE_PROOFRELAY_ADDRESS is required here: off Galileo
# there is no compiled-in fallback, and the UI says so in a banner rather than
# signing against an address that holds no code.
VITE_API_URL=http://127.0.0.1:8080
VITE_CHAIN_ID=16661
VITE_PROOFRELAY_ADDRESS=
VITE_OG_RPC_URL=https://evmrpc.0g.ai
