# ─── Verifier D ─────────────────────────────────────────────
#
# This process's own file. Loaded BEFORE .env.local and .env, so anything here
# wins — put what belongs to this operator alone in it, and leave everything
# shared (chain, contract, storage, database) in .env.
#
# Read because VERIFIER_PROFILE=d is set when the worker runs.
#
# Copy to .env.verifier-d and fill in. Gitignored, like .env.

VERIFIER_D_PRIVATE_KEY=

# COMPUTE_DRIVER=zerog-router
# COMPUTE_API_KEY=sk-...
#
# Its own key, on the network this deployment runs on — https://pc.0g.ai for
# mainnet (16661), https://pc.testnet.0g.ai for Galileo (16602). See
# .env.verifier-c.example for why the key is per verifier and not shared.

# D's own model — a different vendor from C's, for the same reason C's differs
# from A and B's. Same qualifying test: seedable, TEE-attested, advertising
# temperature / top_p / max_tokens / response_format, and listed by GET /v1/models.
# COMPUTE_MODEL=qwen3.8-flash

# Profile D defaults: depth 2, threshold 0.48 — the most permissive of the four,
# and deliberately the opposite end from C.
# VERIFIER_D_EVIDENCE_DEPTH=2
# VERIFIER_D_SUPPORT_THRESHOLD=0.48

# VERIFIER_MIN_COLLECT_WEI=2000000000000000
