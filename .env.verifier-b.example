# ─── Verifier B ─────────────────────────────────────────────
#
# This process's own file. Loaded BEFORE .env.local and .env, so anything here
# wins — put what belongs to this operator alone in it, and leave everything
# shared (chain, contract, storage, database) in .env.
#
# Read because VERIFIER_PROFILE=b is set when the worker runs.
#
# Copy to .env.verifier-b and fill in. Gitignored, like .env.

VERIFIER_B_PRIVATE_KEY=

# COMPUTE_DRIVER=zerog-router
# COMPUTE_API_KEY=sk-...
#
# The key is what the router bills, NOT this verifier's chain address — the two
# are unrelated accounts, and a key funded from some other wallet works fine.
# Give each verifier its OWN key: the quota below is per key, and one shared key
# would let a busy verifier starve the other, which is the one failure that
# makes two verifiers agree by default instead of by evidence.
#
# Measured on router-api-testnet 2026-09-03, returned in X-Ratelimit-* headers:
#   10 requests per minute, 50 per day, per key.
# One verification spends 1-2 completions (claim extraction is skipped when the
# task ships its own claims), so a key is good for roughly 25-50 tasks a day.
# Past the daily cap the adapter falls back to the local engine and says so in
# the report trace: provider reads `zerog-router(fallback:local)`.

# Profile B defaults: depth 3, threshold 0.50 — deliberately unlike A's.
# VERIFIER_B_EVIDENCE_DEPTH=3
# VERIFIER_B_SUPPORT_THRESHOLD=0.50

# VERIFIER_MIN_COLLECT_WEI=2000000000000000
