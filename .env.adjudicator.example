# ─── Adjudicator ─────────────────────────────────────────────
#
# This process's own file. Loaded BEFORE .env.local and .env, so anything here
# wins — put what belongs to this operator alone in it, and leave everything
# shared (chain, contract, storage, database) in .env.
#
# Read because main.ts sets PROOFRELAY_ROLE=adjudicator.
#
# Copy to .env.adjudicator and fill in. Gitignored, like .env.

# Holds ADJUDICATOR_ROLE and can reallocate a disputed task's reward, bounded by
# the bounty. Separate it from the keeper and admin keys before mainnet.
ADJUDICATOR_PRIVATE_KEY=

# COMPUTE_DRIVER=zerog-router
# COMPUTE_API_KEY=sk-...

# A third configuration. With COMPUTE_DRIVER=local only the threshold can move a
# verdict — evidenceDepth changes how many spans are cited, never the verdict —
# so 0.6 is deliberately unlike both verifier profiles (0.55 and 0.50). Real
# independence needs a different model, which zerog-router buys and local cannot.
# ADJUDICATOR_EVIDENCE_DEPTH=4
# ADJUDICATOR_SUPPORT_THRESHOLD=0.6
# ADJUDICATOR_POLL_MS=5000
