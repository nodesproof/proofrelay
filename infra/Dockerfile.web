FROM node:22-bookworm-slim AS build
WORKDIR /app
ARG VITE_API_URL=http://localhost:8080
ARG VITE_CHAIN_ID=16602
ARG VITE_PROOFRELAY_ADDRESS=
ENV VITE_API_URL=$VITE_API_URL VITE_CHAIN_ID=$VITE_CHAIN_ID VITE_PROOFRELAY_ADDRESS=$VITE_PROOFRELAY_ADDRESS

COPY proofrelay-frontend/package.json proofrelay-frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY proofrelay-frontend ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist/public /usr/share/nginx/html
# wouter does client-side routing, so every unknown path has to reach index.html
# or a refresh on /task/0x… would 404.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
