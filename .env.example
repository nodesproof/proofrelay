# ProofRelay configuration.
#
# PRECEDENCE, highest first:
#   1. variables already exported in the environment
#   2. .env.local   <- GENERATED by `npm run seed` / `npm run demo`
#   3. .env         <- this file, edited by you
#
# .env.local wins over .env. That is deliberate (it holds the deployed address
# and the throwaway database for the machine), but it also means a .env.local
# left over from `npm run demo` will keep every service on the local chain no
# matter what you put here. If a service reports the wrong chain, look there
# first: `grep CHAIN_ID .env.local`. Deleting the file is safe — re-running
# `npm run seed` regenerates it.
#
# Do not run `npm run wallets` or `cp .env.example .env` over a .env that
# already holds funded keys.
#
# For 0G mainnet (chain 16661) start from `.env.mainnet.example` instead — it
# carries the mainnet RPC, storage indexer and compute notes, and spells out
# what differs when there is no faucet behind a mistake.

# ─── Chain ────────────────────────────────────────────────────────────────────
# 0G Galileo testnet = 16602. 0G mainnet = 16661. Local anvil = 31337.
# Everything network-shaped — RPC, explorer, storage indexer, compute router and
# model, block cadence — is defaulted from this one value.
CHAIN_ID=16602
OG_RPC_URL=https://evmrpc-testnet.0g.ai
PROOFRELAY_ADDRESS=0x0000000000000000000000000000000000000000
# Block the contract was deployed in — printed by `npm run deploy`.
# The indexer starts here rather than scanning the chain from genesis; on
# Galileo that is the difference between 3.5k blocks and 52 million, and the
# API refuses to start with this at 0 on a public chain.
PROOFRELAY_DEPLOY_BLOCK=0

# Keeper submits finalizeConsensus. It holds no admin power and cannot withdraw
# escrow; keep its balance small. Never the user's key.
KEEPER_PRIVATE_KEY=
# Adjudicator resolves challenges. Operator-held for the MVP.
ADJUDICATOR_PRIVATE_KEY=
# One key per role. `npm run roles` audits that and reads every dotenv file to
# do it — a copy of a key in .env.local or .env.<role> WINS over this file, so a
# rotation written only here can be silently overridden. `npm run roles:separate`
# fixes both cases; `npm run roles:apply` moves the onchain grants to match.
#
# Deployer/admin. Use a multisig for anything beyond a testnet demo.
PRIVATE_KEY=
ADMIN_ADDRESS=
KEEPER_ADDRESS=
ADJUDICATOR_ADDRESS=
VERIFIER_A_ADDRESS=
VERIFIER_B_ADDRESS=
STORAGE_ADDRESS=
# Optional second pauser, so an incident can be stopped without the admin key.
# The constructor already grants PAUSER_ROLE to the admin; `npm run roles:apply`
# grants it to this address too when it is set.
PAUSER_ADDRESS=

# ─── 0G Storage ───────────────────────────────────────────────────────────────
# local  = filesystem content-addressed store (no funding required)
# zerog  = real 0G Storage via @0gfoundation/0g-storage-ts-sdk; needs a funded key
#          for storage fees (a 500-byte artifact costs ~6e-8 0G plus ~0.0017 0G gas)
STORAGE_DRIVER=local
STORAGE_ROOT=.proofrelay/storage
STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
STORAGE_PRIVATE_KEY=
# Optional read-only fallbacks, tried before the local mirror when the indexer is down.
STORAGE_GATEWAYS=

# ─── 0G Compute ───────────────────────────────────────────────────────────────
# local             = deterministic offline entailment engine (used by the tests)
# zerog-router      = 0G Compute Router, OpenAI-compatible
# zerog-broker      = direct provider via @0gfoundation/0g-compute-ts-sdk
# openai-compatible = any other OpenAI-compatible endpoint
#
# The router is PER NETWORK and the catalogs do not overlap. Galileo (16602) is
# served from a third-party host — router-api-testnet.0g.ai does not resolve, so
# do not "correct" the URL below. Keys, balances and models are separate between
# testnet and mainnet. Leaving these unset simply keeps COMPUTE_DRIVER=local.
#
#   testnet 16602: https://router-api-testnet.integratenetwork.work/v1
#                  model qwen2.5-omni, key from https://pc.testnet.0g.ai
#   mainnet 16661: https://router-api.0g.ai/v1
#                  model deepseek-v4-flash, key from https://pc.0g.ai
#
# The mainnet default model is deliberate. COMPUTE_REQUIRE_PARAMETERS below
# refuses a provider that would drop the seed, and on mainnet the glm-5.x
# providers do exactly that — they advertise `temperature` and not `seed`.
# `curl -s https://router-api.0g.ai/v1/providers` is public and is the authority
# on which models can actually be seeded.
#
# Both are defaulted from CHAIN_ID, so setting only COMPUTE_DRIVER and
# COMPUTE_API_KEY is enough.
COMPUTE_DRIVER=local
COMPUTE_BASE_URL=
COMPUTE_API_KEY=
COMPUTE_MODEL=
# Only for COMPUTE_DRIVER=zerog-broker: this key funds the on-chain ledger and
# signs every request, which is what lets that driver run with no API key at all.
COMPUTE_PRIVATE_KEY=
# verify_tee makes the router hold the connection while it checks the provider's
# attestation, on top of generation. The result lands in a report's compute trace.
COMPUTE_TIMEOUT_MS=90000
COMPUTE_VERIFY_TEE=true
COMPUTE_TRUST_MODE=verified
# Refuse a provider that would silently drop seed/temperature — otherwise a
# report would claim a reproducibility it does not have.
COMPUTE_REQUIRE_PARAMETERS=true
COMPUTE_SEED=1337

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# How many reverse proxies sit in front of the API. 0 trusts none, so
# request.ip is the socket peer. A deployment behind a TLS terminator MUST
# set this, or every anonymous caller resolves to the proxy and shares one
# rate-limit bucket. Setting it where no proxy exists lets any client forge
# X-Forwarded-For and escape its own bucket.
TRUST_PROXY_HOPS=0

# Per-IP budget for the two routes that spend the operator's own 0G:
# POST /v1/tasks/prepare and POST /v1/tasks/:id/challenge. Each accepted
# prepare writes up to 21 objects to 0G Storage on STORAGE_PRIVATE_KEY.
SPEND_RATE_LIMIT_MAX=10
DATABASE_URL=postgres://proofrelay:proofrelay@localhost:5432/proofrelay

# Used by infra/docker-compose.yml for the postgres service and every
# DATABASE_URL it builds. Postgres is bound to 127.0.0.1 there, but the
# credential still must not be the literal in the compose file.
POSTGRES_PASSWORD=proofrelay
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
SESSION_TTL_SEC=3600
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
PRODUCER_ID=proofrelay-api/1.0.0

# Source fetching. Leave FETCH_ALLOW_PRIVATE at 0 outside a test harness:
# it is the switch that keeps the SSRF guard on.
FETCH_MAX_BYTES=524288
FETCH_TIMEOUT_MS=15000
FETCH_ALLOW_PRIVATE=0

# ─── Indexer and keeper ───────────────────────────────────────────────────────
INDEXER_ENABLED=true
INDEXER_POLL_MS=2000
INDEXER_CONFIRMATIONS=2
# Leave unset to start at PROOFRELAY_DEPLOY_BLOCK. Set it only to start LATER
# than the deployment; a value below the deploy block is ignored.
# INDEXER_START_BLOCK=
INDEXER_BATCH_SIZE=2000
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_POLL_MS=1500

# ─── Verifier workers ─────────────────────────────────────────────────────────
VERIFIER_A_PRIVATE_KEY=
VERIFIER_B_PRIVATE_KEY=
VERIFIER_POLL_MS=3000

# ─── Web ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8080
VITE_CHAIN_ID=16602
VITE_PROOFRELAY_ADDRESS=
VITE_OG_RPC_URL=https://evmrpc-testnet.0g.ai
